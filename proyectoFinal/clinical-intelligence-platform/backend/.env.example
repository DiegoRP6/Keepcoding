# Application
APP_NAME="Clinical Intelligence Platform"

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/clinical_ai

# CORS
CORS_ORIGINS=http://localhost:5173

# Whisper (transcripción local con faster-whisper)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=es
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_CPU_THREADS=4

# LLM fine-tuneado (dialogue -> SOAP en inglés)
LLM_MODEL_BASE=Qwen/Qwen2.5-1.5B-Instruct
LLM_ADAPTER_DIR=./modelo_soap_qwen_lora

# Traducción ES<->EN (API de OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
